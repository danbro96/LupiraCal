{
  "name": "lupira-cal-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "gen:api": "npm run gen -w packages/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.10.0"
  },
  "allowScripts": {
    "@sentry/cli": false,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
