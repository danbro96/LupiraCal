<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Merged into the app manifest by the library merger — this is what makes the module approach
       survive prebuild without any config-plugin manifest surgery. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.WRITE_CONTACTS" />
  <!-- Install-time (non-runtime) permissions: setSyncAutomatically/setIsSyncable need WRITE. -->
  <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
  <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

  <!-- Lets the router find the system calendar app for events that aren't ours. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="vnd.android.cursor.item/event" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.lupirabridge.AuthenticatorService"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accounts.AccountAuthenticator" />
      </intent-filter>
      <meta-data
        android:name="android.accounts.AccountAuthenticator"
        android:resource="@xml/lupira_authenticator" />
    </service>

    <service
      android:name="expo.modules.lupirabridge.CalendarSyncService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.content.SyncAdapter" />
      </intent-filter>
      <meta-data
        android:name="android.content.SyncAdapter"
        android:resource="@xml/lupira_syncadapter_calendar" />
    </service>

    <service
      android:name="expo.modules.lupirabridge.ContactsSyncService"
      android:exported="true">
      <intent-filter>
        <action android:name="android.content.SyncAdapter" />
      </intent-filter>
      <meta-data
        android:name="android.content.SyncAdapter"
        android:resource="@xml/lupira_syncadapter_contacts" />
      <meta-data
        android:name="android.provider.CONTACTS_STRUCTURE"
        android:resource="@xml/lupira_contacts" />
    </service>

    <!-- Everything other apps hand us: provider event/contact intents and shared calendar/contact files. -->
    <activity
      android:name="expo.modules.lupirabridge.IntentRouterActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.item/vnd.com.lupira.calendar.contact" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.item/event" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.INSERT" />
        <action android:name="android.intent.action.EDIT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.dir/event" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.EDIT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.item/event" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" />
        <data android:scheme="file" />
        <data android:mimeType="text/calendar" />
        <data android:mimeType="application/ics" />
        <data android:mimeType="text/x-vcalendar" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" />
        <data android:scheme="file" />
        <data android:mimeType="text/vcard" />
        <data android:mimeType="text/x-vcard" />
        <data android:mimeType="text/directory" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.INSERT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="vnd.android.cursor.dir/contact" />
        <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
      </intent-filter>
    </activity>
  </application>
</manifest>
