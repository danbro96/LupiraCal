{
  "name": "lupira-cal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:maplibre",
    "build": "tsc -b && vite build",
    "prebuild": "npm run sync:maplibre",
    "sync:maplibre": "node -e \"const fs=require('fs'),p=require('path');const d=p.join(p.dirname(require.resolve('maplibre-gl/package.json')),'dist');fs.mkdirSync('public/maplibre',{recursive:true});for(const f of['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync(p.join(d,f),p.join('public/maplibre',f))\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lupira/cal-api": "*",
    "@lupira/cal-domain": "*",
    "@lupira/cal-tokens": "*",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "maplibre-gl": "^6.1.0",
    "pmtiles": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "orval": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.16"
  }
}
